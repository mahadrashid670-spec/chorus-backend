# Copy this file to .env and fill in real values before running

# Any long random string - used to sign login tokens
JWT_SECRET=change-this-to-a-long-random-string

# Port the server runs on (Railway/Render set this automatically in production)
PORT=3000

# Your frontend's URL, so CORS allows it to call this API
FRONTEND_ORIGIN=http://localhost:5500

# --- Paddle (payments) ---
# From your Paddle dashboard (Developer Tools > Authentication)
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# The Price ID for your $19/mo Pro plan (Paddle dashboard > Catalog > Prices)
PADDLE_PRO_PRICE_ID=
